{
  "name": "solace",
  "productName": "Solace",
  "version": "0.15.3",
  "description": "Solace — 本地 PDF 私人图书馆：集中管理、手动分类、轻量预览。",
  "author": "Molly",
  "license": "MIT",
  "homepage": "https://github.com/wisemen-dev/Solace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wisemen-dev/Solace.git"
  },
  "bugs": {
    "url": "https://github.com/wisemen-dev/Solace/issues"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/library.test.js test/watcher.test.js test/notes.test.js test/main-ipc.test.js",
    "test:renderer": "node --experimental-vm-modules test/renderer-smoke.mjs && node --experimental-vm-modules test/preview-notes.test.mjs && node --experimental-vm-modules test/cache-lifecycle.test.mjs && node --experimental-vm-modules test/settings-lifecycle.test.mjs && node --experimental-vm-modules test/palette-lifecycle.test.mjs",
    "dist": "electron-builder --win nsis",
    "icon": "node scripts/make-icon.js"
  },
  "build": {
    "appId": "com.molly.solace",
    "productName": "Solace",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Solace",
      "artifactName": "Solace-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "lxgw-wenkai-lite-webfont": "^1.7.0",
    "pdfjs-dist": "^4.10.38"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
